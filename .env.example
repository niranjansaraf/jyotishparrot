# Copy this file to .env and fill in your values (never commit .env)

# Required — your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional — override the default model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional — path for readings.db (set to /data on Railway with a Volume)
# DATA_DIR=/data

# Optional — port (default: 5000)
# PORT=5000
